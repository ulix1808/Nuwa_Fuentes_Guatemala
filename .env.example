# Carpeta local del corpus (JSON + control + exports)
DATA_DIR=data

# Pausa entre navegaciones (segundos). Sube si Guatecompras bloquea.
REQUEST_DELAY_S=2.5

# Tope de espera cuando el sitio cae o Cloudflare reta (segundos)
SITE_DOWN_PAUSE_S=180
SITE_DOWN_PAUSE_MAX_S=900

# Reintentos por operación
MAX_ATTEMPTS=8
RETRY_BASE_S=5
RETRY_MAX_S=120

# true = ventana visible (útil si Cloudflare pide challenge)
HEADED=false
